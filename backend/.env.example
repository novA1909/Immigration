# ============================================
# Immigration CMS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!
# ============================================

# --------------------------------------------
# Server Configuration
# --------------------------------------------

# Port number for the backend server
# Default: 5000
PORT=5000

# Node environment (development, production, test)
# Affects logging, error messages, etc.
NODE_ENV=development

# --------------------------------------------
# Database Configuration (MongoDB)
# --------------------------------------------

# MongoDB connection string
# Local: mongodb://localhost:27017/immigration-cms
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/immigration-cms
MONGODB_URI=mongodb://localhost:27017/immigration-cms

# --------------------------------------------
# JWT Configuration
# --------------------------------------------

# Secret key for signing JWT tokens
# Generate a random string: openssl rand -base64 32
# Keep this SECRET and SECURE!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time
# Examples: '24h', '7d', '30d', '3600' (seconds)
JWT_EXPIRE=30d

# --------------------------------------------
# Cloudinary Configuration
# --------------------------------------------

# Cloudinary cloud name (from dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API key (from dashboard)
CLOUDINARY_API_KEY=your-api-key

# Cloudinary API secret (from dashboard)
# Keep this SECRET!
CLOUDINARY_API_SECRET=your-api-secret

# --------------------------------------------
# Anthropic Claude AI Configuration
# --------------------------------------------

# Anthropic API key for Claude 3.5 Sonnet
# Get from: https://console.anthropic.com/
# Keep this SECRET!
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --------------------------------------------
# Email Configuration (NodeMailer)
# --------------------------------------------

# Email service provider (gmail, outlook, sendgrid, etc.)
EMAIL_SERVICE=gmail

# Email address to send from
EMAIL_FROM=your-email@gmail.com

# Email password or app-specific password
# For Gmail: Use App Password (not regular password)
# Enable 2FA and create app password: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password

# SMTP host (if not using preset service)
# EMAIL_HOST=smtp.gmail.com

# SMTP port (if not using preset service)
# EMAIL_PORT=587

# --------------------------------------------
# Frontend Configuration
# --------------------------------------------

# Frontend URL for CORS configuration
# Development: http://localhost:3000
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# --------------------------------------------
# Optional: Rate Limiting
# --------------------------------------------

# Maximum requests per window per IP
# RATE_LIMIT_MAX=100

# Rate limit window in minutes
# RATE_LIMIT_WINDOW=15

# --------------------------------------------
# Optional: File Upload Limits
# --------------------------------------------

# Maximum file size in MB
# MAX_FILE_SIZE=10

# --------------------------------------------
# Optional: Admin Configuration
# --------------------------------------------

# Default admin email (for seeding)
# ADMIN_EMAIL=admin@immigration-cms.com

# Default admin password (for seeding)
# ADMIN_PASSWORD=Admin123!

# ============================================
# Setup Instructions
# ============================================
#
# 1. MongoDB:
#    - Install MongoDB locally OR
#    - Create free cluster at mongodb.com/atlas
#    - Update MONGODB_URI with your connection string
#
# 2. Cloudinary:
#    - Create free account at cloudinary.com
#    - Get cloud name, API key, API secret from dashboard
#    - Update CLOUDINARY_* variables
#
# 3. Anthropic Claude:
#    - Create account at console.anthropic.com
#    - Get API key from dashboard
#    - Update ANTHROPIC_API_KEY
#
# 4. Email (NodeMailer):
#    - For Gmail: Enable 2FA and create app password
#    - For other: Configure SMTP settings
#    - Update EMAIL_* variables
#
# 5. JWT Secret:
#    - Generate random string: openssl rand -base64 32
#    - Update JWT_SECRET
#
# 6. Save as .env (remove .example extension)
#
# ============================================
